export const IDLE_LIMIT: number;
export const RUN_PAUSE: number;
export type LineSplitter = { push(bytes: Uint8Array): string[]; readonly pending: number };
export type Header = { width: number; height: number; timestamp: number };
export type Event = { time: number; code: string; data: string };
export type ParsedLine = { header: Header; event?: undefined } | { event: Event; header?: undefined } | null;
export type Op = { kind: "o"; run: number; t: number; data: string } | { kind: "size"; run: number; t: number; cols: number; rows: number };
export type Run = { timestamp: number; firstOp: number };
export type Recording = { runs: Run[]; ops: Op[]; play: { idle: number[]; full: number[] }; cols: number; rows: number; lastT: number };
export type Write = { data: string; cols?: undefined; rows?: undefined } | { cols: number; rows: number; data?: undefined };
export function createLineSplitter(): LineSplitter;
export function parseLine(line: string): ParsedLine;
export function parseSize(data: string): { cols: number; rows: number } | null;
export function createRecording(): Recording;
export function addRecord(recording: Recording, record: ParsedLine): void;
export function addLines(recording: Recording, lines: string[]): void;
export function duration(recording: Recording, idleSkip: boolean): number;
export function opsDue(recording: Recording, idleSkip: boolean, pos: number): number;
export function positionOf(recording: Recording, idleSkip: boolean, count: number): number;
export function sizeAt(recording: Recording, count: number): { cols: number; rows: number };
export function wallClockAt(recording: Recording, idleSkip: boolean, pos: number): number | null;
export function runMarks(recording: Recording, idleSkip: boolean): { index: number; position: number; timestamp: number }[];
export function writesBetween(recording: Recording, from: number, to: number, maxChars?: number): Write[];
export function exportCast(recording: Recording): string;
