export const systemTeam: string;
export const refKinds: string[];
export const codeExists: string;
export const codeReserved: string;
export const codeInUse: string;
export const defaultsAPI: string;
export const newTeamLink: string;
export const inspectAPI: string;

export type TeamSummary = {
  name: string; realm: string; projectUrl?: string; projectRef?: string;
  roles: string[]; rolesInherited: boolean; harnesses: string[]; harnessesInherited: boolean;
  configs: string[]; system?: boolean;
};
export type FormSource = { alias: string; stored?: string; url?: string; refKind?: string; ref?: string; clonePath?: string; identity?: string };
export type FormTask = { name: string; schedule?: string; suspend: boolean | null; args?: string };
export type FormRoleConnector = { name: string; enabled: boolean; identity?: string };
export type FormRole = { name: string; source: string; path: string; harness?: string; initialPath?: string; image: string[]; tasks: { all: boolean; items: FormTask[] }; connectors?: FormRoleConnector[] };
export type FormHarness = { name: string; source: string; path: string };
export type FormConnector = { method?: string; identity?: string };
export type TeamForm = {
  name: string; project?: FormSource; sources: FormSource[] | null;
  roles: { inherit: boolean; items: FormRole[] }; harnesses: { inherit: boolean; items: FormHarness[] };
  connectors: { inherit: boolean; items: Record<string, FormConnector> };
};
export type ViewSource = { alias: string; stored?: string; url: string; ref?: string; clonePath?: string; identity?: string; declared: boolean };
export type ViewRole = {
  name: string; source: string; path: string; harness?: string; initialPath?: string; image: string[]; secrets: string[];
  allTasks: boolean; selected: { name: string; schedule?: string; suspend?: boolean; args?: string }[];
};
export type ScheduleSpec = { cron: string; timezone?: string; concurrencyPolicy?: string; startingDeadlineSeconds?: number; suspend?: boolean };
export type ScheduleState = { lastScheduleTime?: string; nextScheduleTime?: string; lastCell?: string; activeCells?: string[]; skippedFires?: number; lastError?: string };
export type ViewTask = { role: string; task: string; config: string; scope: string[]; schedule?: ScheduleSpec; status?: ScheduleState };
// RoleConnectorView is one connector a Config of the team resolves (#1649): a row of kuke team connector list.
export type RoleConnectorView = {
  role: string; config: string; task?: string; connector: string; method?: string; state: string;
  identity?: string; origin?: string; required?: boolean; fill: string; setByTeam: boolean;
};
export type ViewConfig = { name: string; scope: string[]; role?: string; task?: string };
export type TeamDetail = {
  project?: ViewSource;
  sources: { inherited: boolean; items: ViewSource[] };
  roles: { inherited: boolean; items: ViewRole[] };
  harnesses: { inherited: boolean; items: FormHarness[] };
  connectors: { inherited: boolean; items: { name: string; method?: string; identity?: string }[]; roles?: RoleConnectorView[] };
  tasks: ViewTask[]; configs: ViewConfig[]; unresolved?: string;
};
export type TeamView = { summary: TeamSummary; document: string; view?: TeamDetail; form?: TeamForm; problem?: string };
export type PlannedTask = { name: string; config: string; schedule?: string; suspend?: boolean };
export type PlannedPair = { role: string; harness: string; config: string; image: string; components?: string[]; tasks?: PlannedTask[] };
export type PlannedSource = { name: string; url: string; ref: string; commit?: string };
export type Plan = {
  command: string; origin: { kind: string; detail?: string }; declaration: string;
  sources: PlannedSource[] | null; pairs: PlannedPair[] | null;
  create: string[] | null; rerender: string[] | null; prune: string[] | null;
  missingSecrets: string[] | null; createSecrets: string[] | null; notes: string[] | null;
};
export type TeamResult = { team: string; resources: number; pruned: string[]; missingSecrets: string[]; notes: string[] };
export type TeamOutcome = { plan: Plan; result?: TeamResult };
export type Source = { name: string; url: string; branch?: string; tag?: string; commit?: string; identity?: string };
export type Selection = { name: string; source: string; path: string };
export type SourceUse = { team?: string; as: string; name: string };
export type StoredSource = Source & { usedBy: SourceUse[]; defaultRoles: Selection[]; defaultHarnesses: Selection[] };
export type Sources = { sources: StoredSource[]; defaultRoles: Selection[]; defaultHarnesses: Selection[] };
export type OfferedTask = { name: string; schedule?: string; suspend?: boolean; args?: string };
export type OfferedRole = { name: string; path: string; harnesses: string[]; tasks: OfferedTask[]; default: boolean };
export type OfferedHarness = { name: string; path: string; default: boolean };
export type SourceContents = { source: Source; commit?: string; roles: OfferedRole[]; harnesses: OfferedHarness[] };
export type SourceChange = { action: string; source: Source; usedBy: SourceUse[]; discovered?: SourceContents };
export type DefaultsChange = { action: string; inheriting: string[] };
export type DraftSource = { alias: string; stored: string; url: string; ref?: string; identity?: string; state: string; have?: string; contents?: SourceContents };
export type Draft = { origin: { kind: string; detail?: string }; name: string; form: TeamForm; declaration: string; sources: DraftSource[]; notes: string[] };
export type DeleteResult = { deleted: boolean; removed: { kind: string; name: string; action: string }[]; liveCells: string[]; keptVolumes: string[] };
export type SourceForm = { name: string; url: string; refKind: string; ref: string; identity: string; force?: boolean };

export function teamsLink(name?: string, section?: "edit" | "export"): string;
export function sourcesLink(name?: string): string;
export function teamsAPI(name?: string, action?: string): string;
export function exportAPI(name: string, options?: { hostFields?: boolean; explicit?: boolean }): string;
export function sourcesAPI(name?: string, action?: string): string;
export function refOf(source: unknown): { kind: string; value: string };
export function refLabel(source: unknown): string;
export function withRef<T extends Record<string, unknown>>(out: T, kind: string | undefined, value: string | undefined): T;
export function refErrors(kind: string | undefined, value: string | undefined): string[];
export function validName(value: string | undefined): boolean;
export function editPayload(name: string, declaration: string): { name: string; declaration: string };
export function needsForce(failure: unknown): boolean;
export function planSections(plan: Plan | undefined): { key: string; title: string; items: string[] }[];
export function originLabel(origin: unknown): string;
export function taskLabel(task: unknown): string;
export function pairRows(plan: Plan | undefined): { key: string; role: string; harness: string; config: string; image: string; components: string[]; tasks: string[] }[];
export function sourceItems(contents: unknown): { roles: OfferedRole[]; harnesses: OfferedHarness[] };
export function toggledDefaults(current: Sources | undefined, kind: "role" | "harness", item: { name: string; source: string; path: string }, on: boolean): { roles?: string[]; harnesses?: string[] };
export function isDefault(current: Sources | undefined, kind: "role" | "harness", source: string, path: string): boolean;
export function sourcePayload(form: Partial<SourceForm>): Record<string, unknown>;
export function sourceErrors(form: Partial<SourceForm>): string[];
export function usesLabel(use: SourceUse): string;
export function sourceTeams(source: StoredSource | undefined): string[];
export function inheritingNote(change: DefaultsChange | undefined): string;
export function deleteSummary(result: DeleteResult | undefined): { removed: string[]; liveCells: string[]; keptVolumes: string[] };
export function teamConfigs(configs: unknown, team: string): { name: string; scope: string[] }[];
export function listOrigin(list: { inherited?: boolean } | undefined): string;
export function configLink(scope: string[], name: string): string;
export function repositoryFromSource(source: unknown): { name: string; url: string; branch: string; ref: string };
