export const deliveryEnv: string;
export const deliveryFile: string;
export const deliveryStateVolume: string;
export const deliveryGit: string;
export const deliveryRegistry: string;
export const fieldString: string;
export const fieldList: string;
export const fieldPerson: string;
export const fieldSecret: string;
export const secretOpaque: string;
export const secretBasicAuth: string;
export const secretSSHKey: string;
export const scopeLevels: string[];
export const stateResolved: string;
export const statePending: string;
export const teamLabel: string;
export const defaultScopeName: string;

export type SecretRef = { name: string; realm: string; space?: string; stack?: string };
export type Scope = { realm: string; space?: string; stack?: string };
export type ConnectorField = { name: string; type?: string; required?: boolean; help?: string; enum?: string[]; secretTypes?: string[] };
export type FormField = { name: string; type: string; required: boolean; help: string; enum: string[] };
export type ConnectorMethod = { name: string; component: string; description?: string; default?: boolean; delivery: string; slot?: string; envName?: string; mountPath?: string };
export type Connector = {
  name: string; title: string; description?: string; delivery?: string; group?: string; harness?: string; optional?: boolean;
  scopes: string[]; secretTypes: string[]; fields: ConnectorField[]; methods: ConnectorMethod[];
};
export type ConnectorStatus = {
  connector: string; title?: string; component: string; method?: string; delivery: string; slot?: string; state: string;
  required?: boolean; identity?: SecretRef; origin?: string; volume?: string; message?: string;
};
export type ConfigMetadata = { name: string; realm?: string; space?: string; stack?: string; labels?: Record<string, string> };
export type ConnectorMissing = { config: ConfigMetadata; component: string; method?: string; slot?: string; delivery: string; message?: string };
export type ConnectorUsage = { connector: string; configs: number; missing: ConnectorMissing[] };
export type ConnectorDefault = { connector: string; method?: string; component?: string; delivery: string; slot?: string; levels: Record<string, SecretRef>; effective?: SecretRef; origin?: string };
export type DefaultTarget = { method: string; component: string; delivery: string; slot: string; description: string };
export type Identity = { name: string; realm: string; space: string; stack: string; type: string; identity: Record<string, string> };
export type IdentityForm = {
  name: string; type: string; fields: Record<string, string>;
  value: string; username: string; password: string; privateKey: string; passphrase: string; publicKey: string; certificate: string; knownHosts: string;
};
export type GroupMember = { name: string; optional: boolean; group: string; description: string; connector: { name: string; method: string } | null };
export type RegistryEntry = { server: string; username: string; secret?: SecretRef };
// Any document that may carry status.connectors: a CellConfig, or nothing.
type StatusCarrier = unknown;

export function takesIdentity(delivery: string | undefined): boolean;
export function secretRef(value: Partial<SecretRef> | undefined | null): SecretRef | undefined;
export function refKey(value: Partial<SecretRef> | undefined | null): string;
export function sameRef(a: Partial<SecretRef> | undefined | null, b: Partial<SecretRef> | undefined | null): boolean;
export function refScope(value: Partial<SecretRef> | undefined | null): string[];
export function refLabel(value: Partial<SecretRef> | undefined | null): string;
export function formatSecretReference(value: Partial<SecretRef> | undefined | null): string;
export function identitiesFor(secrets: unknown[] | undefined, connector: string): Identity[];
export function connectorStatuses(config: StatusCarrier): ConnectorStatus[];
export function blocksCells(status: ConnectorStatus | undefined): boolean;
export function blockingConnectors(config: StatusCarrier): ConnectorStatus[];
export function connectorTitle(status: { title?: string; connector?: string } | undefined): string;
export function originLabel(origin: string | undefined, team?: string): string;
export function teamOf(config: { metadata?: { labels?: Record<string, string> } } | undefined): string;
export function targetScope(metadata: { realm?: string; space?: string; stack?: string } | undefined): Required<Scope>;
export function scopeAt(scope: Partial<Scope> | undefined, level: string): Scope;
export function scopeLevel(scope: Partial<Scope> | undefined): string;
export function scopeParts(scope: Partial<Scope> | undefined): string[];
export function scopeFromParts(parts: string[] | undefined): Scope;
export function connectorLevels(connector: { scopes?: string[] } | undefined): string[];
export function allowedLevels(connector: { scopes?: string[] } | undefined, scope: Partial<Scope> | undefined): string[];
export function scopeQuery(scope: Partial<Scope> | undefined): string;
export function defaultTargets(connector: Connector | undefined): DefaultTarget[];
export function defaultRow(defaults: ConnectorDefault[] | undefined, target: { connector: string; component?: string; method?: string }): ConnectorDefault | undefined;
export function loginMethods(connector: Connector | undefined): ConnectorMethod[];
export function isRegistry(connector: Connector | undefined): boolean;
export function usageFor(usage: ConnectorUsage[] | undefined, connector: string): { configs: number; missing: ConnectorMissing[] };
export function groupComponents<T extends GroupMember>(components: T[] | undefined): { groups: Array<{ group: string; members: T[] }>; ungrouped: T[] };
export function defaultGroupChoices(components: GroupMember[] | undefined, connectors: Connector[] | undefined): Record<string, string>;
export function pickableStatuses(statuses: ConnectorStatus[] | undefined): ConnectorStatus[];
export function changedPicks(statuses: ConnectorStatus[] | undefined, picks: Record<string, Partial<SecretRef> | undefined> | undefined): Record<string, SecretRef>;
export function methodChoices(connector: Connector | undefined): ConnectorMethod[];
export function changedMethods(statuses: ConnectorStatus[] | undefined, picks: Record<string, string | undefined> | undefined): Record<string, string>;
export function methodStatuses(statuses: ConnectorStatus[] | undefined, connectors: Connector[] | undefined, picks: Record<string, string | undefined> | undefined): ConnectorStatus[];
export function unresolvedConnectors(statuses: ConnectorStatus[] | undefined, picks: Record<string, Partial<SecretRef> | undefined> | undefined): ConnectorStatus[];
export function identityFields(connector: { fields?: ConnectorField[] } | undefined, type: string): FormField[];
export function secretTypesOf(connector: { secretTypes?: string[] } | undefined): string[];
export function emptyIdentityForm(connector: { secretTypes?: string[] } | undefined, existing?: { name?: string; type?: string; identity?: Record<string, string> }): IdentityForm;
export function parseList(value: string | undefined): string[];
export function identityErrors(connector: { fields?: ConnectorField[]; secretTypes?: string[] } | undefined, form: IdentityForm): string[];
export function identityPayload(connector: { fields?: ConnectorField[]; secretTypes?: string[] } | undefined, scope: Partial<Scope>, form: IdentityForm): Record<string, unknown>;
export function clearMaterial(form: IdentityForm): IdentityForm;
export function registryEntries(realm: unknown): RegistryEntry[];
